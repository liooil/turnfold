{
  "name": "turnfold",
  "version": "0.1.0",
  "description": "A local-first repository for branching AI conversations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liooil/turnfold.git"
  },
  "bugs": {
    "url": "https://github.com/liooil/turnfold/issues"
  },
  "homepage": "https://liooil.github.io/turnfold/",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun run build.ts",
    "build:pages": "bun run typecheck && bun run build-pages.ts",
    "rust:check": "cargo check --workspace",
    "start": "NODE_ENV=production bun src/server.ts",
    "test": "bun test",
    "test:history": "bun run build && bun history.test.mjs"
  },
  "dependencies": {
    "dompurify": "3.2.6",
    "fflate": "0.8.2",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "mathjax": "4.1.3",
    "typescript": "5.9.3"
  }
}
