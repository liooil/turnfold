[Unit]
Description=Turnfold local-first runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/turnfold
ExecStart=%h/.local/lib/turnfold/turnfold serve --listen 127.0.0.1:3000 --database %h/.local/share/turnfold/turnfold.db --vault-keyring default
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=%h/.local/share/turnfold

[Install]
WantedBy=default.target
